<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 公共目录读写所需 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ModuleApplication"
        android:theme="@style/AppTheme"
        android:label="@string/app_name">

        <!-- libxposed 102：作用域在 META-INF/xposed/ 下声明，这里保留老框架识别用的 meta-data -->
        <meta-data android:name="xposedminversion" android:value="102" />
        <meta-data android:name="xposeddescription" android:value="模块说明" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LSPosed 入口（老框架）：新框架走 libxposed service，两者可并存 -->
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标挂 alias：「隐藏图标」只禁用 alias，不影响 LSPosed 入口 -->
        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".ui.DetailActivity" android:exported="false" android:theme="@style/AppTheme" />
        <activity android:name=".ui.LogViewerActivity" android:exported="false" android:theme="@style/AppTheme" />
        <activity android:name=".ui.AboutActivity" android:exported="false" android:theme="@style/AppTheme" />
    </application>
</manifest>
